<Application x:Class="BdoCronCalculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#131518" />
        <SolidColorBrush x:Key="BgPanel" Color="#1c1f24" />
        <SolidColorBrush x:Key="BgButton" Color="#252a32" />
        <SolidColorBrush x:Key="BgButtonHover" Color="#323842" />
        <SolidColorBrush x:Key="BgButtonPressed" Color="#1e2228" />

        <SolidColorBrush x:Key="BgOpButton" Color="#202b38" />
        <SolidColorBrush x:Key="BgOpButtonHover" Color="#28394a" />
        <SolidColorBrush x:Key="BgOpButtonPressed" Color="#19232e" />

        <SolidColorBrush x:Key="BgCronButton" Color="#123545" />
        <SolidColorBrush x:Key="BgTaxButton" Color="#2d2208" />
        <SolidColorBrush x:Key="BgEqualsButton" Color="#00838f" />

        <SolidColorBrush x:Key="AccentCron" Color="#00e5ff" />
        <SolidColorBrush x:Key="AccentCronGlow" Color="#184b55" />
        <SolidColorBrush x:Key="AccentCronHover" Color="#26eeff" />

        <SolidColorBrush x:Key="AccentGold" Color="#ffc107" />
        <SolidColorBrush x:Key="TextPrimary" Color="#f0f3f6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8a94a2" />
        <SolidColorBrush x:Key="BorderDark" Color="#2d333d" />

        <!-- Standard Button Style -->
        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgButton}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgButtonHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#454f5f" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Operator Button Style -->
        <Style x:Key="OpButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BgOpButton}" />
            <Setter Property="Foreground" Value="{StaticResource AccentCron}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgOpButtonHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCron}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgOpButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Equals Button Style -->
        <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BgEqualsButton}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00acc1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006064" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cron Button Style -->
        <Style x:Key="CronButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BgCronButton}" />
            <Setter Property="Foreground" Value="{StaticResource AccentCron}" />
            <Setter Property="BorderBrush" Value="#00b4d8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1b4d63" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCronHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0c2531" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tax Button Style -->
        <Style x:Key="TaxButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BgTaxButton}" />
            <Setter Property="Foreground" Value="{StaticResource AccentGold}" />
            <Setter Property="BorderBrush" Value="#997300" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#47360c" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#ffc107" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1f1805" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
