<Window x:Class="BdoCronCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BDO Cron Calculator"
        Width="350"
        Height="580"
        MinWidth="260"
        MinHeight="54"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        Icon="cronstone.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
    </Window.Effect>

    <Border x:Name="MainOuterBorder"
            Background="{StaticResource BgDark}"
            BorderBrush="{StaticResource BorderDark}"
            BorderThickness="1.5"
            CornerRadius="12"
            Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="38" />
                <!-- Main Body Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0"
                    x:Name="TitleBarBorder"
                    Background="{StaticResource BgPanel}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Image Grid.Column="0"
                           Source="cronstone.png"
                           Width="20"
                           Height="20"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                    <!-- Title -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock Text="BDO " FontWeight="Bold" Foreground="{StaticResource AccentCron}" FontSize="12" />
                        <TextBlock Text="Calculator" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Grind Spot Tool Button -->
                    <Button Grid.Column="2"
                            x:Name="GrindToolButton"
                            Height="24"
                            Padding="5,0"
                            Margin="1,0"
                            Click="GrindToolButton_Click"
                            ToolTip="Grind Spot Trash Loot Calculator"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚔ " FontSize="11" Foreground="#4caf50" VerticalAlignment="Center" />
                            <TextBlock Text="Grind" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Hammer vs Cron Tool Button -->
                    <Button Grid.Column="3"
                            x:Name="HammerToolButton"
                            Height="24"
                            Padding="5,0"
                            Margin="1,0"
                            Click="HammerToolButton_Click"
                            ToolTip="Hammer vs. Cron Stone Value Tool"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔨 " FontSize="11" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center" />
                            <TextBlock Text="Hammer" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- HUD Mini Mode Toggle Button -->
                    <Button Grid.Column="4"
                            x:Name="HudButton"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="HudButton_Click"
                            ToolTip="Compact HUD Mini-Mode (H / F9)"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="🗗" FontSize="12" Foreground="{StaticResource AccentCron}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Settings Button -->
                    <Button Grid.Column="5"
                            x:Name="SettingsButton"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="SettingsButton_Click"
                            ToolTip="Settings &amp; Transparency"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="⚙" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Always-on-Top Pin Button -->
                    <Button Grid.Column="6"
                            x:Name="PinButton"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="PinButton_Click"
                            ToolTip="Always on Top (Enabled)"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock x:Name="PinIcon" Text="📌" FontSize="11" Foreground="{StaticResource AccentCron}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Grid.Column="7"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            FontSize="13"
                            Content="—"
                            Cursor="Hand" />

                    <!-- Close Button -->
                    <Button Grid.Column="8"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#ff5252"
                            FontSize="13"
                            FontWeight="Bold"
                            Content="✕"
                            Cursor="Hand" />
                </Grid>
            </Border>

            <!-- 2. Standard View Grid -->
            <Grid Grid.Row="1" x:Name="StandardView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Display Section -->
                    <RowDefinition Height="Auto" />
                    <!-- Cron Action Bar -->
                    <RowDefinition Height="44" />
                    <!-- Standard Calculator Keypad -->
                    <RowDefinition Height="*" />
                    <!-- Quick Silver Multipliers / Footer -->
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <!-- Display Section -->
                <Border Grid.Row="0"
                        x:Name="DisplayBorder"
                        Background="#101215"
                        BorderBrush="{StaticResource BorderDark}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>

                        <!-- In-App Update Banner -->
                        <Border Grid.Row="0"
                                x:Name="UpdateBanner"
                                Background="#183642"
                                BorderBrush="{StaticResource AccentCron}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                Margin="0,0,0,4"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✨ " FontSize="11" />
                                    <TextBlock x:Name="UpdateBannerText" Text="Update available!" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="UpdateNowButton"
                                        Height="20"
                                        Padding="8,0"
                                        Margin="6,0,4,0"
                                        Background="{StaticResource AccentCron}"
                                        Foreground="#131518"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Content="Update"
                                        Cursor="Hand"
                                        Click="UpdateNowButton_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextSecondary}"
                                        FontSize="10"
                                        Content="✕"
                                        Cursor="Hand"
                                        Click="DismissUpdate_Click" />
                            </Grid>
                        </Border>

                        <!-- Expression Tape / History -->
                        <TextBlock Grid.Row="1"
                                   x:Name="ExpressionTapeText"
                                   Text=""
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Main Number Display -->
                        <TextBlock Grid.Row="2"
                                   x:Name="MainDisplayText"
                                   Text="0"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Live Silver Breakdown Summary -->
                        <Border Grid.Row="3"
                                Background="#1b2028"
                                CornerRadius="4"
                                Padding="6,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰 " FontSize="10" VerticalAlignment="Center" />
                                <TextBlock x:Name="SilverSummaryText"
                                           Text="0 Silver"
                                           Foreground="{StaticResource AccentGold}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Cron & Market Tax Action Bar -->
                <Border Grid.Row="1" x:Name="ActionBarBorder" Background="{DynamicResource BgPanel}" Padding="6,4" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <!-- Main Vendor Cron Button (3,000,000) -->
                        <Button Grid.Column="0"
                                Style="{StaticResource CronButtonStyle}"
                                Click="CronButton_Click"
                                ToolTip="Multiply by 3,000,000 (Vendor Cron Stone Price)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="cronstone.png" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="CRON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCron}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Outfit Extraction Cron Button (2.18M) -->
                        <Button Grid.Column="2"
                                Style="{StaticResource CalcButtonStyle}"
                                Click="OutfitCronButton_Click"
                                ToolTip="Multiply by 2,180,000 (Outfit Extraction Cron Price)">
                            <TextBlock Text="Outfit (2.18M)" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </Button>

                        <!-- Market Tax Calculator Button -->
                        <Button Grid.Column="4"
                                x:Name="TaxButton"
                                Style="{StaticResource TaxButtonStyle}"
                                Click="TaxButton_Click"
                                ToolTip="Calculate Net Market Silver after Tax &amp; Bonuses">
                            <TextBlock Text="💰 Tax" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Standard Keypad Grid -->
                <Grid Grid.Row="2" Margin="4,4">
                    <Viewbox Stretch="Uniform" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Grid Width="300" Height="270">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Clear & Division -->
                            <Button Grid.Row="0" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Foreground="#ff6b6b" Content="C" Click="Clear_Click" />
                            <Button Grid.Row="0" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Foreground="#ffab40" Content="CE" Click="ClearEntry_Click" />
                            <Button Grid.Row="0" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="⌫" Click="Backspace_Click" />
                            <Button Grid.Row="0" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="÷" Click="Operator_Click" Tag="÷" />

                            <!-- Row 1: 7, 8, 9, × -->
                            <Button Grid.Row="1" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="7" Click="Digit_Click" Tag="7" />
                            <Button Grid.Row="1" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="8" Click="Digit_Click" Tag="8" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="9" Click="Digit_Click" Tag="9" />
                            <Button Grid.Row="1" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="×" Click="Operator_Click" Tag="×" />

                            <!-- Row 2: 4, 5, 6, - -->
                            <Button Grid.Row="2" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="4" Click="Digit_Click" Tag="4" />
                            <Button Grid.Row="2" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="5" Click="Digit_Click" Tag="5" />
                            <Button Grid.Row="2" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="6" Click="Digit_Click" Tag="6" />
                            <Button Grid.Row="2" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="-" Click="Operator_Click" Tag="-" />

                            <!-- Row 3: 1, 2, 3, + -->
                            <Button Grid.Row="3" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="1" Click="Digit_Click" Tag="1" />
                            <Button Grid.Row="3" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="2" Click="Digit_Click" Tag="2" />
                            <Button Grid.Row="3" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="3" Click="Digit_Click" Tag="3" />
                            <Button Grid.Row="3" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="+" Click="Operator_Click" Tag="+" />

                            <!-- Row 4: ±, 0, ., = -->
                            <Button Grid.Row="4" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="±" Click="Negate_Click" />
                            <Button Grid.Row="4" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="0" Click="Digit_Click" Tag="0" />
                            <Button Grid.Row="4" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="." Click="Digit_Click" Tag="." />
                            <Button Grid.Row="4" Grid.Column="3" Margin="3" Style="{StaticResource EqualsButtonStyle}" Content="=" Click="Equals_Click" />
                        </Grid>
                    </Viewbox>
                </Grid>

                <!-- Quick Multipliers / Copy Bar -->
                <Border Grid.Row="3" x:Name="FooterBorder" Background="{DynamicResource BgPanel}" CornerRadius="0,0,10,10" Padding="6,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Margin="1" Style="{StaticResource CalcButtonStyle}" FontSize="11" Content="+k" ToolTip="Multiply by 1,000" Click="Multiply_k_Click" />
                        <Button Grid.Column="1" Margin="1" Style="{StaticResource CalcButtonStyle}" FontSize="11" Content="+M" ToolTip="Multiply by 1,000,000" Click="Multiply_M_Click" />
                        <Button Grid.Column="2" Margin="1" Style="{StaticResource CalcButtonStyle}" FontSize="11" Content="+B" ToolTip="Multiply by 1,000,000,000" Click="Multiply_B_Click" />
                        <Button Grid.Column="3" Margin="1" Style="{StaticResource CalcButtonStyle}" FontSize="11" Content="📋 Copy" ToolTip="Copy formatted result to clipboard" Click="Copy_Click" />
                        
                        <!-- Bottom-Right Resize Grip Thumb -->
                        <Thumb x:Name="ResizeGripThumb"
                               Grid.Column="4"
                               Width="20"
                               Height="20"
                               Cursor="SizeNWSE"
                               DragDelta="ResizeGripThumb_DragDelta"
                               Background="Transparent"
                               BorderThickness="0"
                               ToolTip="Drag to resize window">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock Text="⋰" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,2,2" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Compact HUD Mini-Mode View -->
            <Border Grid.Row="1" x:Name="HudView" Visibility="Collapsed" Background="#101215" CornerRadius="0,0,10,10" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
                        <TextBlock x:Name="HudDisplayText" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HudSilverText" Text="💰 0 Silver" Foreground="{StaticResource AccentGold}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="1" Height="26" Padding="6,0" Margin="2,0" Style="{StaticResource CronButtonStyle}" Click="CronButton_Click" ToolTip="CRON (3.0M)">
                        <TextBlock Text="CRON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCron}" />
                    </Button>

                    <Button Grid.Column="2" Height="26" Padding="6,0" Margin="2,0" Style="{StaticResource TaxButtonStyle}" Click="TaxButton_Click" ToolTip="Tax Calculator">
                        <TextBlock Text="💰 Tax" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGold}" />
                    </Button>

                    <Button Grid.Column="3" Height="26" Padding="6,0" Margin="2,0" Style="{StaticResource CalcButtonStyle}" Click="Copy_Click" ToolTip="Copy Silver">
                        <TextBlock Text="📋" FontSize="11" />
                    </Button>

                    <Button Grid.Column="4" Height="26" Width="26" Margin="2,0" Style="{StaticResource CalcButtonStyle}" Click="HudButton_Click" ToolTip="Expand to Full Calculator">
                        <TextBlock Text="⤢" FontSize="13" Foreground="{StaticResource AccentCron}" FontWeight="Bold" />
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Grind Spot Trash Loot Calculator Overlay View -->
            <Border x:Name="GrindOverlay"
                    Grid.Row="1"
                    Background="#131518"
                    Visibility="Collapsed"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,1,0,0"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚔ " FontSize="14" Foreground="#4caf50" />
                            <TextBlock Text="Grind Spot Trash Loot Calculator" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Spot Selector Card -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Select Grind Spot" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                                    <ComboBox x:Name="GrindSpotComboBox"
                                              Margin="0,6,0,4"
                                              Height="28"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="GrindSpotComboBox_SelectionChanged" />
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock x:Name="GrindSpotInfoLabel" Text="Recommended: —" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="GrindRegionLabel" Text="Region: —" Foreground="{StaticResource AccentCron}" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Trash Loot Quantity Card -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Trash Loot Amount" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="TrashCountTextBox"
                                                 Width="120"
                                                 Height="28"
                                                 Text="0"
                                                 Background="#101215"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 BorderBrush="{StaticResource BorderDark}"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Right"
                                                 FontSize="13"
                                                 FontWeight="Bold"
                                                 Padding="4,0"
                                                 TextChanged="TrashInputs_TextChanged" />
                                    </Grid>
                                    <!-- Quick Multipliers -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Margin="1" Style="{StaticResource CalcButtonStyle}" Height="22" FontSize="10" Content="+5k" Click="AddTrash_5k_Click" />
                                        <Button Grid.Column="1" Margin="1" Style="{StaticResource CalcButtonStyle}" Height="22" FontSize="10" Content="+10k" Click="AddTrash_10k_Click" />
                                        <Button Grid.Column="2" Margin="1" Style="{StaticResource CalcButtonStyle}" Height="22" FontSize="10" Content="+20k" Click="AddTrash_20k_Click" />
                                        <Button Grid.Column="3" Margin="1" Style="{StaticResource CalcButtonStyle}" Height="22" FontSize="10" Content="+50k" Click="AddTrash_50k_Click" />
                                        <Button Grid.Column="4" Margin="1" Style="{StaticResource CalcButtonStyle}" Height="22" FontSize="10" Content="Clr" Foreground="#ff6b6b" Click="ClearTrash_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Unit Price (Customizable) -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Trash Unit Price (Silver)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                                        <TextBlock Text="Auto-filled or enter custom" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             x:Name="TrashPriceTextBox"
                                             Width="120"
                                             Height="28"
                                             Text="0"
                                             Background="#101215"
                                             Foreground="{StaticResource AccentCron}"
                                             BorderBrush="{StaticResource BorderDark}"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Right"
                                             FontSize="13"
                                             FontWeight="Bold"
                                             Padding="4,0"
                                             TextChanged="TrashInputs_TextChanged" />
                                </Grid>
                            </Border>

                            <!-- Rare Drop / Extra Silver -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Extra / Rare Drops (Silver)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                                        <TextBlock Text="Debo drop, Caphras, Black stones..." Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             x:Name="ExtraSilverTextBox"
                                             Width="120"
                                             Height="28"
                                             Text="0"
                                             Background="#101215"
                                             Foreground="{StaticResource AccentGold}"
                                             BorderBrush="{StaticResource BorderDark}"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Right"
                                             FontSize="13"
                                             FontWeight="Bold"
                                             Padding="4,0"
                                             TextChanged="TrashInputs_TextChanged" />
                                </Grid>
                            </Border>

                            <!-- Calculated Session Silver Card -->
                            <Border Background="#1b2028" BorderBrush="#4caf50" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="SESSION ESTIMATED SILVER" FontWeight="Bold" Foreground="#4caf50" FontSize="11" />
                                    <TextBlock x:Name="GrindTotalSilverText" Text="0 Silver" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                    <TextBlock x:Name="GrindFormattedSummaryText" Text="0 Silver" Foreground="{StaticResource AccentGold}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource EqualsButtonStyle}"
                                Height="34"
                                Content="➡️ Send to Calculator"
                                FontSize="12"
                                Click="SendGrindToCalc_Click" />
                        <Button Grid.Column="2"
                                Style="{StaticResource CalcButtonStyle}"
                                Height="34"
                                Content="Close"
                                FontSize="12"
                                Click="CloseGrindOverlay_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 5. Hammer vs. Cron Value Comparison Overlay View -->
            <Border x:Name="HammerOverlay"
                    Grid.Row="1"
                    Background="#131518"
                    Visibility="Collapsed"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,1,0,0"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔨 " FontSize="14" Foreground="{StaticResource AccentGold}" />
                            <TextBlock Text="Hammer vs. Cron Comparison" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Target Selector -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Select Enhancement Target" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                                    <ComboBox x:Name="HammerTargetComboBox"
                                              Margin="0,6,0,4"
                                              Height="28"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="HammerTargetComboBox_SelectionChanged" />
                                    <TextBlock x:Name="HammerTargetInfoLabel" Text="Item: —" Foreground="{StaticResource AccentCron}" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- Hammer Market Price Input -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Hammer Market Price (Silver)" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                                        <TextBlock Text="Current Central Market cost" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             x:Name="HammerPriceTextBox"
                                             Width="120"
                                             Height="28"
                                             Text="27500000000"
                                             Background="#101215"
                                             Foreground="{StaticResource AccentGold}"
                                             BorderBrush="{StaticResource BorderDark}"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Right"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             Padding="4,0"
                                             TextChanged="HammerPrice_TextChanged" />
                                </Grid>
                            </Border>

                            <!-- Comparison 3 Cards -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Vendor Crons -->
                                <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="#00b4d8" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                    <StackPanel>
                                        <TextBlock Text="Vendor Crons" Foreground="{StaticResource AccentCron}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Text="@ 3.0M" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                        <TextBlock x:Name="HammerVendorCostLabel" Text="0 B" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Outfit Crons -->
                                <Border Grid.Column="2" Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                    <StackPanel>
                                        <TextBlock Text="Outfit Crons" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Text="@ 2.18M" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                        <TextBlock x:Name="HammerOutfitCostLabel" Text="0 B" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Hammer Price -->
                                <Border Grid.Column="4" Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                    <StackPanel>
                                        <TextBlock Text="Hammer Market" Foreground="{StaticResource AccentGold}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Text="Marketplace" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                        <TextBlock x:Name="HammerMarketCostLabel" Text="27.5 B" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Recommendation Banner -->
                            <Border x:Name="HammerRecommendationBorder" Background="#1b2028" BorderBrush="{StaticResource AccentGold}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="ANALYSIS &amp; RECOMMENDATION" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontSize="10" />
                                    <TextBlock x:Name="HammerRecommendationText"
                                               Text="Calculating..."
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource EqualsButtonStyle}"
                                Height="34"
                                Content="➡️ Send Cost to Calc"
                                FontSize="12"
                                Click="SendHammerToCalc_Click" />
                        <Button Grid.Column="2"
                                Style="{StaticResource CalcButtonStyle}"
                                Height="34"
                                Content="Close"
                                FontSize="12"
                                Click="CloseHammerOverlay_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 6. Settings Overlay View -->
            <Border x:Name="SettingsOverlay"
                    Grid.Row="1"
                    Background="#131518"
                    Visibility="Collapsed"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,1,0,0"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Settings Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙ " FontSize="14" Foreground="{StaticResource AccentGold}" />
                            <TextBlock Text="Settings &amp; Preferences" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Settings Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Background Opacity / Transparency Setting -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Background Opacity" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                            <TextBlock Text="Dark glass transparency (0 - 100%)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="OpacityValueLabel" Text="95%" Foreground="{StaticResource AccentCron}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="OpacitySlider"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="95"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Margin="0,8,0,0"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>
                            </Border>

                            <!-- Button Opacity / Transparency Setting -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Button Opacity" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                            <TextBlock Text="Button tiles transparency (0 - 100%)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="ButtonOpacityValueLabel" Text="90%" Foreground="{StaticResource AccentCron}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="ButtonOpacitySlider"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="90"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Margin="0,8,0,0"
                                            ValueChanged="ButtonOpacitySlider_ValueChanged" />
                                </StackPanel>
                            </Border>

                            <!-- Value Pack Setting -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Value Pack" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                        <TextBlock Text="+30% Silver Collection bonus" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ValuePackCheckBox" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Rich Merchant Ring Setting -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rich Merchant's Ring" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                        <TextBlock Text="+5% Market Silver bonus" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="MerchantRingCheckBox" IsChecked="False" Checked="SettingsChanged" Unchecked="SettingsChanged" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Family Fame Setting -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Family Fame" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                            <TextBlock x:Name="FameBonusLabel" Text="+1.5% (≥ 7,000 Fame)" Foreground="{StaticResource AccentCron}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 x:Name="FamilyFameTextBox"
                                                 Width="85"
                                                 Height="28"
                                                 Text="7000"
                                                 Background="#101215"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 BorderBrush="{StaticResource BorderDark}"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Right"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 Padding="4,0"
                                                 TextChanged="FamilyFameTextBox_TextChanged" />
                                    </Grid>
                                    <TextBlock Text="Tiers: 1k (+0.5%) | 4k (+1.0%) | 7k+ (+1.5%)" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Live Rates Card -->
                            <Border Background="#1b2028" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="CURRENT MARKET RATES" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontSize="11" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Payout Rate:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="SettingsPayoutRateText" Text="85.48%" Foreground="#4caf50" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Market Tax:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="SettingsTaxRateText" Text="-14.52%" Foreground="#ff5252" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Work in Progress / Project Info Card -->
                            <Border Background="#161a20" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛠 " FontSize="11" />
                                        <TextBlock Text="WORK IN PROGRESS" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="11" />
                                        <TextBlock x:Name="AppVersionLabel" Text=" (v1.3.0)" Foreground="{StaticResource AccentCron}" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="This calculator is actively maintained and receives regular updates. You will be prompted automatically when a new update is released."
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Done Button -->
                    <Button Grid.Row="2"
                            Style="{StaticResource EqualsButtonStyle}"
                            Height="38"
                            Margin="0,10,0,0"
                            Content="Done &amp; Save Settings"
                            FontSize="13"
                            Click="CloseSettings_Click" />
                </Grid>
            </Border>

            <!-- Edge & Corner Resize Handles (Full Window Perimeter) -->
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Right" Width="6" VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="ResizeRight_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="2" VerticalAlignment="Bottom" Height="6" HorizontalAlignment="Stretch" Cursor="SizeNS" DragDelta="ResizeBottom_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Left" Width="6" VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="ResizeLeft_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="2" VerticalAlignment="Top" Height="6" HorizontalAlignment="Stretch" Cursor="SizeNS" DragDelta="ResizeTop_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNWSE" DragDelta="ResizeGripThumb_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNESW" DragDelta="ResizeBottomLeft_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14" Cursor="SizeNESW" DragDelta="ResizeTopRight_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Cursor="SizeNWSE" DragDelta="ResizeTopLeft_DragDelta" Background="Transparent" Opacity="0" />
        </Grid>
    </Border>
</Window>
