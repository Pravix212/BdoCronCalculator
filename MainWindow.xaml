<Window x:Class="BdoCronCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BDO Cron Calculator"
        Width="340"
        Height="560"
        MinWidth="260"
        MinHeight="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        Icon="cronstone.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
    </Window.Effect>

    <Border x:Name="MainOuterBorder"
            Background="{StaticResource BgDark}"
            BorderBrush="{StaticResource BorderDark}"
            BorderThickness="1.5"
            CornerRadius="12"
            Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="38" />
                <!-- Display Section -->
                <RowDefinition Height="Auto" />
                <!-- Cron Action Bar -->
                <RowDefinition Height="44" />
                <!-- Standard Calculator Keypad -->
                <RowDefinition Height="*" />
                <!-- Quick Silver Multipliers / Footer -->
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0"
                    x:Name="TitleBarBorder"
                    Background="{StaticResource BgPanel}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Image Grid.Column="0"
                           Source="cronstone.png"
                           Width="20"
                           Height="20"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                    <!-- Title -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock Text="BDO " FontWeight="Bold" Foreground="{StaticResource AccentCron}" FontSize="12" />
                        <TextBlock Text="Cron Calculator" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Settings Button -->
                    <Button Grid.Column="2"
                            x:Name="SettingsButton"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="SettingsButton_Click"
                            ToolTip="Central Market Tax Settings"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="⚙" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Always-on-Top Pin Button -->
                    <Button Grid.Column="3"
                            x:Name="PinButton"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="PinButton_Click"
                            ToolTip="Always on Top (Enabled)"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock x:Name="PinIcon" Text="📌" FontSize="11" Foreground="{StaticResource AccentCron}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Grid.Column="4"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            FontSize="13"
                            Content="—"
                            Cursor="Hand" />

                    <!-- Close Button -->
                    <Button Grid.Column="5"
                            Width="26"
                            Height="24"
                            Margin="1,0"
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#ff5252"
                            FontSize="13"
                            FontWeight="Bold"
                            Content="✕"
                            Cursor="Hand" />
                </Grid>
            </Border>

            <!-- 2. Display Section -->
            <Border Grid.Row="1"
                    x:Name="DisplayBorder"
                    Background="#101215"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>

                    <!-- In-App Update Banner -->
                    <Border Grid.Row="0"
                            x:Name="UpdateBanner"
                            Background="#183642"
                            BorderBrush="{StaticResource AccentCron}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,0,4"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✨ " FontSize="11" />
                                <TextBlock x:Name="UpdateBannerText" Text="v1.2.6 available!" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="UpdateNowButton"
                                    Height="20"
                                    Padding="8,0"
                                    Margin="6,0,4,0"
                                    Background="{StaticResource AccentCron}"
                                    Foreground="#131518"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Content="Update"
                                    Cursor="Hand"
                                    Click="UpdateNowButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Grid.Column="2"
                                    Width="18"
                                    Height="18"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource TextSecondary}"
                                    FontSize="10"
                                    Content="✕"
                                    Cursor="Hand"
                                    Click="DismissUpdate_Click" />
                        </Grid>
                    </Border>

                    <!-- Expression Tape / History -->
                    <TextBlock Grid.Row="1"
                               x:Name="ExpressionTapeText"
                               Text=""
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Main Number Display -->
                    <TextBlock Grid.Row="2"
                               x:Name="MainDisplayText"
                               Text="0"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Live Silver Breakdown Summary -->
                    <Border Grid.Row="3"
                            Background="#1b2028"
                            CornerRadius="4"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰 " FontSize="10" VerticalAlignment="Center" />
                            <TextBlock x:Name="SilverSummaryText"
                                       Text="0 Silver"
                                       Foreground="{StaticResource AccentGold}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Cron & Market Tax Action Bar -->
            <Border Grid.Row="2" x:Name="ActionBarBorder" Background="{DynamicResource BgPanel}" Padding="6,4" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <!-- Main Vendor Cron Button (3,000,000) -->
                    <Button Grid.Column="0"
                            Style="{StaticResource CronButtonStyle}"
                            Click="CronButton_Click"
                            ToolTip="Multiply by 3,000,000 (Vendor Cron Stone Price)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="cronstone.png" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="CRON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCron}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Outfit Extraction Cron Button (2.18M) -->
                    <Button Grid.Column="2"
                            Style="{StaticResource CalcButtonStyle}"
                            Click="OutfitCronButton_Click"
                            ToolTip="Multiply by 2,180,000 (Outfit Extraction Cron Price)">
                        <TextBlock Text="Outfit (2.18M)" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    </Button>

                    <!-- Market Tax Calculator Button -->
                    <Button Grid.Column="4"
                            x:Name="TaxButton"
                            Style="{StaticResource TaxButtonStyle}"
                            Click="TaxButton_Click"
                            ToolTip="Calculate Net Market Silver after Tax &amp; Bonuses">
                        <TextBlock Text="💰 Tax" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Standard Keypad Grid -->
            <Grid Grid.Row="3" Margin="4,4">
                <Viewbox Stretch="Uniform" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid Width="300" Height="270">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Clear & Division -->
                        <Button Grid.Row="0" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Foreground="#ff6b6b" Content="C" Click="Clear_Click" />
                        <Button Grid.Row="0" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Foreground="#ffab40" Content="CE" Click="ClearEntry_Click" />
                        <Button Grid.Row="0" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="⌫" Click="Backspace_Click" />
                        <Button Grid.Row="0" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="÷" Click="Operator_Click" Tag="÷" />

                        <!-- Row 1: 7, 8, 9, × -->
                        <Button Grid.Row="1" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="7" Click="Digit_Click" Tag="7" />
                        <Button Grid.Row="1" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="8" Click="Digit_Click" Tag="8" />
                        <Button Grid.Row="1" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="9" Click="Digit_Click" Tag="9" />
                        <Button Grid.Row="1" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="×" Click="Operator_Click" Tag="×" />

                        <!-- Row 2: 4, 5, 6, - -->
                        <Button Grid.Row="2" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="4" Click="Digit_Click" Tag="4" />
                        <Button Grid.Row="2" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="5" Click="Digit_Click" Tag="5" />
                        <Button Grid.Row="2" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="6" Click="Digit_Click" Tag="6" />
                        <Button Grid.Row="2" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="-" Click="Operator_Click" Tag="-" />

                        <!-- Row 3: 1, 2, 3, + -->
                        <Button Grid.Row="3" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="1" Click="Digit_Click" Tag="1" />
                        <Button Grid.Row="3" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="2" Click="Digit_Click" Tag="2" />
                        <Button Grid.Row="3" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="3" Click="Digit_Click" Tag="3" />
                        <Button Grid.Row="3" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="+" Click="Operator_Click" Tag="+" />

                        <!-- Row 4: ±, 0, ., = -->
                        <Button Grid.Row="4" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="±" Click="Negate_Click" />
                        <Button Grid.Row="4" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="0" Click="Digit_Click" Tag="0" />
                        <Button Grid.Row="4" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="." Click="Digit_Click" Tag="." />
                        <Button Grid.Row="4" Grid.Column="3" Margin="3" Style="{StaticResource EqualsButtonStyle}" Content="=" Click="Equals_Click" />
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- 5. Quick Multipliers / Copy Bar -->
            <Border Grid.Row="4" x:Name="FooterBorder" Background="{DynamicResource BgPanel}" CornerRadius="0,0,10,10" Padding="6,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Margin="1" Style="{StaticResource CalcButtonStyle}" FontSize="11" Content="+k" ToolTip="Multiply by 1,000" Click="Multiply_k_Click" />
                    <Button Grid.Column="1" Margin="1" Style="{StaticResource CalcButtonStyle}" FontSize="11" Content="+M" ToolTip="Multiply by 1,000,000" Click="Multiply_M_Click" />
                    <Button Grid.Column="2" Margin="1" Style="{StaticResource CalcButtonStyle}" FontSize="11" Content="+B" ToolTip="Multiply by 1,000,000,000" Click="Multiply_B_Click" />
                    <Button Grid.Column="3" Margin="1" Style="{StaticResource CalcButtonStyle}" FontSize="11" Content="📋 Copy" ToolTip="Copy formatted result to clipboard" Click="Copy_Click" />
                    
                    <!-- Bottom-Right Resize Grip Thumb -->
                    <Thumb x:Name="ResizeGripThumb"
                           Grid.Column="4"
                           Width="20"
                           Height="20"
                           Cursor="SizeNWSE"
                           DragDelta="ResizeGripThumb_DragDelta"
                           Background="Transparent"
                           BorderThickness="0"
                           ToolTip="Drag to resize window">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Text="⋰" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,2,2" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>

            <!-- Edge & Corner Resize Handles (Full Window Perimeter) -->
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Right" Width="6" VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="ResizeRight_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="5" VerticalAlignment="Bottom" Height="6" HorizontalAlignment="Stretch" Cursor="SizeNS" DragDelta="ResizeBottom_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Left" Width="6" VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="ResizeLeft_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="5" VerticalAlignment="Top" Height="6" HorizontalAlignment="Stretch" Cursor="SizeNS" DragDelta="ResizeTop_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNWSE" DragDelta="ResizeGripThumb_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNESW" DragDelta="ResizeBottomLeft_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14" Cursor="SizeNESW" DragDelta="ResizeTopRight_DragDelta" Background="Transparent" Opacity="0" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Cursor="SizeNWSE" DragDelta="ResizeTopLeft_DragDelta" Background="Transparent" Opacity="0" />

            <!-- 6. Settings Overlay View -->
            <Border x:Name="SettingsOverlay"
                    Grid.Row="1"
                    Grid.RowSpan="4"
                    Background="#131518"
                    Visibility="Collapsed"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,1,0,0"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Settings Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙ " FontSize="14" Foreground="{StaticResource AccentGold}" />
                            <TextBlock Text="Settings &amp; Preferences" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Settings Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Background Opacity / Transparency Setting -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Background Opacity" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                            <TextBlock Text="Dark glass transparency (0 - 100%)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="OpacityValueLabel" Text="95%" Foreground="{StaticResource AccentCron}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="OpacitySlider"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="95"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Margin="0,8,0,0"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>
                            </Border>

                            <!-- Button Opacity / Transparency Setting -->
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Button Opacity" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                            <TextBlock Text="Button tiles transparency (0 - 100%)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="ButtonOpacityValueLabel" Text="90%" Foreground="{StaticResource AccentCron}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="ButtonOpacitySlider"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="90"
                                            SmallChange="1"
                                            LargeChange="10"
                                            Margin="0,8,0,0"
                                            ValueChanged="ButtonOpacitySlider_ValueChanged" />
                                </StackPanel>
                            </Border>

                            <!-- Value Pack Setting -->
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Value Pack" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                        <TextBlock Text="+30% Silver Collection bonus" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ValuePackCheckBox" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Rich Merchant Ring Setting -->
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rich Merchant's Ring" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                        <TextBlock Text="+5% Market Silver bonus" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="MerchantRingCheckBox" IsChecked="False" Checked="SettingsChanged" Unchecked="SettingsChanged" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Family Fame Setting -->
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Family Fame" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                                            <TextBlock x:Name="FameBonusLabel" Text="+1.5% (≥ 7,000 Fame)" Foreground="{StaticResource AccentCron}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 x:Name="FamilyFameTextBox"
                                                 Width="85"
                                                 Height="28"
                                                 Text="7000"
                                                 Background="#101215"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 BorderBrush="{StaticResource BorderDark}"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Right"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 Padding="4,0"
                                                 TextChanged="FamilyFameTextBox_TextChanged" />
                                    </Grid>
                                    <TextBlock Text="Tiers: 1k (+0.5%) | 4k (+1.0%) | 7k+ (+1.5%)" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Live Rates Card -->
                            <Border Background="#1b2028" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="CURRENT MARKET RATES" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontSize="11" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Payout Rate:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="SettingsPayoutRateText" Text="85.48%" Foreground="#4caf50" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Market Tax:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="SettingsTaxRateText" Text="-14.52%" Foreground="#ff5252" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Work in Progress / Project Info Card -->
                            <Border Background="#161a20" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛠 " FontSize="11" />
                                        <TextBlock Text="WORK IN PROGRESS" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="11" />
                                        <TextBlock x:Name="AppVersionLabel" Text=" (v1.2.4)" Foreground="{StaticResource AccentCron}" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="This calculator is actively maintained and receives regular updates. You will be prompted automatically when a new update is released."
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Done Button -->
                    <Button Grid.Row="2"
                            Style="{StaticResource EqualsButtonStyle}"
                            Height="38"
