<Window x:Class="BdoCronCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BDO Cron Calculator"
        Width="380"
        Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Icon="cronstone.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
    </Window.Effect>

    <Border Background="{StaticResource BgDark}"
            BorderBrush="{StaticResource BorderDark}"
            BorderThickness="1.5"
            CornerRadius="12"
            Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="42" />
                <!-- Display Section -->
                <RowDefinition Height="125" />
                <!-- Cron Action Bar -->
                <RowDefinition Height="50" />
                <!-- Standard Calculator Keypad -->
                <RowDefinition Height="*" />
                <!-- Quick Silver Multipliers / Footer -->
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Image Grid.Column="0"
                           Source="cronstone.png"
                           Width="22"
                           Height="22"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                    <!-- Title -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="BDO " FontWeight="Bold" Foreground="{StaticResource AccentCron}" FontSize="13" />
                        <TextBlock Text="Cron Calculator" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" />
                    </StackPanel>

                    <!-- Always-on-Top Pin Button -->
                    <Button Grid.Column="2"
                            x:Name="PinButton"
                            Width="30"
                            Height="26"
                            Margin="2,0"
                            Click="PinButton_Click"
                            ToolTip="Always on Top (Enabled)"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock x:Name="PinIcon" Text="📌" FontSize="12" Foreground="{StaticResource AccentCron}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Grid.Column="3"
                            Width="30"
                            Height="26"
                            Margin="2,0"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            FontSize="14"
                            Content="—"
                            Cursor="Hand" />

                    <!-- Close Button -->
                    <Button Grid.Column="4"
                            Width="30"
                            Height="26"
                            Margin="2,0"
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#ff5252"
                            FontSize="14"
                            FontWeight="Bold"
                            Content="✕"
                            Cursor="Hand" />
                </Grid>
            </Border>

            <!-- 2. Display Section -->
            <Border Grid.Row="1"
                    Background="#101215"
                    BorderBrush="{StaticResource BorderDark}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <!-- Expression Tape / History -->
                    <TextBlock Grid.Row="0"
                               x:Name="ExpressionTapeText"
                               Text=""
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Main Number Display -->
                    <TextBlock Grid.Row="1"
                               x:Name="MainDisplayText"
                               Text="0"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Live Silver Breakdown Summary -->
                    <Border Grid.Row="2"
                            Background="#1b2028"
                            CornerRadius="4"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="SilverSummaryText"
                                       Text="0 Silver"
                                       Foreground="{StaticResource AccentGold}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Cron Action Bar -->
            <Border Grid.Row="2" Background="{StaticResource BgPanel}" Padding="8,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Main Vendor Cron Button (3,000,000) -->
                    <Button Grid.Column="0"
                            Style="{StaticResource CronButtonStyle}"
                            Click="CronButton_Click"
                            ToolTip="Multiply by 3,000,000 (Vendor Cron Stone Price)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="cronstone.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="CRON (3M)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCron}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Outfit Extraction Cron Button (2.18M) -->
                    <Button Grid.Column="2"
                            Style="{StaticResource CalcButtonStyle}"
                            Padding="10,0"
                            Click="OutfitCronButton_Click"
                            ToolTip="Multiply by 2,180,000 (Outfit Extraction Cron Price)">
                        <TextBlock Text="Outfit (2.18M)" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Standard Keypad Grid -->
            <Grid Grid.Row="3" Margin="8,8,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Clear & Division -->
                <Button Grid.Row="0" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Foreground="#ff6b6b" Content="C" Click="Clear_Click" />
                <Button Grid.Row="0" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Foreground="#ffab40" Content="CE" Click="ClearEntry_Click" />
                <Button Grid.Row="0" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="⌫" Click="Backspace_Click" />
                <Button Grid.Row="0" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="÷" Click="Operator_Click" Tag="÷" />

                <!-- Row 1: 7, 8, 9, × -->
                <Button Grid.Row="1" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="7" Click="Digit_Click" Tag="7" />
                <Button Grid.Row="1" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="8" Click="Digit_Click" Tag="8" />
                <Button Grid.Row="1" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="9" Click="Digit_Click" Tag="9" />
                <Button Grid.Row="1" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="×" Click="Operator_Click" Tag="×" />

                <!-- Row 2: 4, 5, 6, - -->
                <Button Grid.Row="2" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="4" Click="Digit_Click" Tag="4" />
                <Button Grid.Row="2" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="5" Click="Digit_Click" Tag="5" />
                <Button Grid.Row="2" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="6" Click="Digit_Click" Tag="6" />
                <Button Grid.Row="2" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="-" Click="Operator_Click" Tag="-" />

                <!-- Row 3: 1, 2, 3, + -->
                <Button Grid.Row="3" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="1" Click="Digit_Click" Tag="1" />
                <Button Grid.Row="3" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="2" Click="Digit_Click" Tag="2" />
                <Button Grid.Row="3" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="3" Click="Digit_Click" Tag="3" />
                <Button Grid.Row="3" Grid.Column="3" Margin="3" Style="{StaticResource OpButtonStyle}" Content="+" Click="Operator_Click" Tag="+" />

                <!-- Row 4: ±, 0, ., = -->
                <Button Grid.Row="4" Grid.Column="0" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="±" Click="Negate_Click" />
                <Button Grid.Row="4" Grid.Column="1" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="0" Click="Digit_Click" Tag="0" />
                <Button Grid.Row="4" Grid.Column="2" Margin="3" Style="{StaticResource CalcButtonStyle}" Content="." Click="Digit_Click" Tag="." />
                <Button Grid.Row="4" Grid.Column="3" Margin="3" Style="{StaticResource EqualsButtonStyle}" Content="=" Click="Equals_Click" />
            </Grid>

            <!-- 5. Quick Multipliers / Copy Bar -->
            <Border Grid.Row="4" Background="{StaticResource BgPanel}" CornerRadius="0,0,10,10" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Margin="2" Style="{StaticResource CalcButtonStyle}" FontSize="12" Content="+k (000)" ToolTip="Multiply by 1,000" Click="Multiply_k_Click" />
                    <Button Grid.Column="1" Margin="2" Style="{StaticResource CalcButtonStyle}" FontSize="12" Content="+M (Mil)" ToolTip="Multiply by 1,000,000" Click="Multiply_M_Click" />
                    <Button Grid.Column="2" Margin="2" Style="{StaticResource CalcButtonStyle}" FontSize="12" Content="+B (Bil)" ToolTip="Multiply by 1,000,000,000" Click="Multiply_B_Click" />
                    <Button Grid.Column="3" Margin="2" Style="{StaticResource CalcButtonStyle}" FontSize="12" Content="📋 Copy" ToolTip="Copy formatted result to clipboard" Click="Copy_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
