<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>cronstone.ico</ApplicationIcon>
    <RootNamespace>BdoCronCalculator</RootNamespace>
    <AssemblyName>BdoCronCalculator</AssemblyName>
    
    <!-- Assembly Metadata -->
    <Title>Black Desert Cron &amp; Tax Calculator</Title>
    <Product>Black Desert Cron Calculator</Product>
    <Company>Pravix</Company>
    <Authors>Pravix</Authors>
    <Description>Lightweight desktop &amp; mobile calculator for Black Desert Online enhancement and central market tax.</Description>
    <Copyright>Copyright © 2026 Pravix</Copyright>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="cronstone.png" />
    <Resource Include="cronstone.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BdoCronCalculator.Tests\**\*" />
    <EmbeddedResource Remove="BdoCronCalculator.Tests\**\*" />
    <None Remove="BdoCronCalculator.Tests\**\*" />
    <Page Remove="BdoCronCalculator.Tests\**\*" />
    <Compile Remove="BdoCronCalculator.Mobile\**\*" />
    <EmbeddedResource Remove="BdoCronCalculator.Mobile\**\*" />
    <None Remove="BdoCronCalculator.Mobile\**\*" />
    <Page Remove="BdoCronCalculator.Mobile\**\*" />
    <Compile Remove="Publish\**\*" />
    <None Remove="Publish\**\*" />
  </ItemGroup>

</Project>
